rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function publicConfig() {
      return /databases/$(database)/documents/appConfig/public;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isMainAdmin() {
      return signedIn() && request.auth.token.mainAdmin == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isActiveUser() {
      return signedIn()
        && exists(userDoc(request.auth.uid))
        && get(userDoc(request.auth.uid)).data.status == "active";
    }

    function provider() {
      return request.auth.token.firebase.sign_in_provider;
    }

    function autoApproveGoogle() {
      return exists(publicConfig()) && get(publicConfig()).data.autoApproveGoogle == true;
    }

    function autoApproveEmail() {
      return exists(publicConfig()) && get(publicConfig()).data.autoApproveEmail == true;
    }

    function validSelfUserCreate(uid) {
      return isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "student"
        && request.resource.data.provider == provider()
        && (
          request.resource.data.status == "pending"
          || (request.resource.data.status == "active"
            && ((provider() == "google.com" && autoApproveGoogle())
              || (provider() == "password" && autoApproveEmail())))
        );
    }

    function userSafeKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["displayName", "photoURL", "lastLoginAt", "updated_at"]);
    }

    match /appConfig/{docId} {
      allow read: if docId == "public";
      allow create, update, delete: if isMainAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isMainAdmin() || validSelfUserCreate(uid);
      allow update: if isMainAdmin()
        || (isOwner(uid) && resource.data.status != "suspended" && userSafeKeysOnly());
      allow delete: if isMainAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isActiveUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.status == "pending"
        && request.resource.data.fileData is string
        && request.resource.data.fileData.size() <= 900000;
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == "pending");
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid && resource.data.status == "pending");
    }

    match /uploads/{uploadId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 80
        && request.resource.data.mime.matches('(application/pdf|image/.*)')
        && (request.resource.data.visibility == "private"
          || (request.resource.data.visibility == "public" && isAdmin()));
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.visibility == resource.data.visibility);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);

      match /chunks/{chunkId} {
        function parent() {
          return get(/databases/$(database)/documents/uploads/$(uploadId));
        }

        allow read: if true;
        allow create: if isActiveUser()
          && parent().data.ownerUid == request.auth.uid
          && request.resource.data.index is int
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 700000;
        allow update, delete: if isAdmin() || (signedIn() && parent().data.ownerUid == request.auth.uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
