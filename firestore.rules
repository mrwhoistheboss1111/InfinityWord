rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isMainAdmin() {
      return signedIn() && request.auth.token.mainAdmin == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userSafeKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["displayName", "photoURL", "lastLoginAt", "updated_at"]);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isMainAdmin();
      allow update: if isMainAdmin()
        || (isOwner(uid) && userSafeKeysOnly());
      allow delete: if isMainAdmin();
    }

    match /questions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerUid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.status == "pending";
      allow update: if isAdmin()
        || (isOwner(resource.data.ownerUid)
          && resource.data.status == "pending"
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == "pending");
      allow delete: if isAdmin();
    }

    match /uploads/{uploadId} {
      allow read: if signedIn()
        && (resource.data.visibility == "public" || resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 80
        && request.resource.data.mime.matches('(application/pdf|image/.*)')
        && (request.resource.data.visibility == "private"
          || (request.resource.data.visibility == "public" && isAdmin()));
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.visibility == resource.data.visibility);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);

      match /chunks/{chunkId} {
        function parent() {
          return get(/databases/$(database)/documents/uploads/$(uploadId));
        }

        allow read: if signedIn()
          && (parent().data.visibility == "public" || parent().data.ownerUid == request.auth.uid || isAdmin());
        allow create: if signedIn()
          && parent().data.ownerUid == request.auth.uid
          && request.resource.data.index is int
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 700000;
        allow update, delete: if isAdmin() || (signedIn() && parent().data.ownerUid == request.auth.uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
